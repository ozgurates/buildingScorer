# Streamlit Cloud / local secrets template.
#
# To deploy on Streamlit Community Cloud:
#   1. Open your app in https://share.streamlit.io
#   2. Settings → Secrets
#   3. Paste the contents of this file (with real values) and save
#
# To run locally with this instead of .env:
#   Save as .streamlit/secrets.toml (already gitignored)

SENDER_EMAIL = "your@gmail.com"
SENDER_APP_PASSWORD = "your-app-password"
RECIPIENT_EMAIL = "client@email.com"

SPREADSHEET_NAME = "survey_responses"

# Service-account credentials as a TOML section. Copy each field
# from your credentials.json. Keep `private_key` as a single line with
# real \n escape sequences (NOT actual newlines). Use double-quoted
# strings — TOML basic strings preserve `\n` correctly when used as a
# *single-line* value (the escape is interpreted, but JSON also wants
# a real newline so the round-trip is fine when consumed as a dict).
[gcp_service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@your-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
