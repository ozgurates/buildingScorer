# Copy to .env and fill in the values.

# Gmail SMTP. Generate an app password at:
# Google Account → Security → 2-Step Verification → App Passwords → "Mail"
SENDER_EMAIL=your@gmail.com
SENDER_APP_PASSWORD=your-app-password
RECIPIENT_EMAIL=client@email.com

# Path to the Google service-account credentials JSON, and the
# spreadsheet name shared with the service account email.
GOOGLE_CREDENTIALS_PATH=credentials.json
SPREADSHEET_NAME=survey_responses
